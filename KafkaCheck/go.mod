module KafkaCheck

// Используем последнюю стабильную версию Go
go 1.23

require (
	// Kafka клиент для Go (IBM Sarama - самая популярная библиотека)
	github.com/IBM/sarama v1.44.0

	// Protocol Buffers для сериализации сообщений
	google.golang.org/protobuf v1.35.2

	// YAML парсер для загрузки конфигурации
	gopkg.in/yaml.v3 v3.0.1
)

